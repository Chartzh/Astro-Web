# Optional: point the Digital Twin at the physical ASTRO unit.
# The firmware (Astro/Astro_M1_Web.ino) serves its Web UI over LAN, so deploy
# this SvelteKit app reachable from the same network and set the base URL below.
# Leave unset to run the Twin in local SIMULATOR mode.
# VITE_ASTRO_URL=http://192.168.1.23

# Optional: call the real Gemini API right from the browser — a faithful port of
# the firmware's askGemini() (Astro/Astro_M1_Web.ino). Set VITE_GEMINI_API_KEY
# and (optionally) VITE_GEMINI_MODEL to go live; leave VITE_GEMINI_API_KEY unset
# to keep using the local mock. NOTE: the key is exposed in the client bundle —
# use a restricted/key-guarded key for a public deployment.
# VITE_GEMINI_API_KEY=AIza...
# `gemini-3.6-flash` is the current stable model for this API region. Older
# names like gemini-2.0-flash are retired (HTTP 404). Leaving this unset uses
# gemini-3.6-flash. The historical HTTP 400 was caused by an invalid
# `thinkingConfig` in the request body, not the model name.
# VITE_GEMINI_MODEL=gemini-3.6-flash